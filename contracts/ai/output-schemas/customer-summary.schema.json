{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crm-bds-ai.local/contracts/ai/output-schemas/customer-summary.schema.json",
  "title": "Customer Summary Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "known_requirements",
    "missing_information",
    "recommended_actions",
    "evidence"
  ],
  "properties": {
    "summary": {
      "type": "string"
    },
    "known_requirements": {
      "type": "object"
    },
    "missing_information": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommended_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "reason"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    }
  }
}
