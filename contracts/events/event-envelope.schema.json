{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crm-bds-ai.local/contracts/events/event-envelope.schema.json",
  "title": "CRM_BDS_AI Event Envelope (canonical baseline, Sprint 1)",
  "description": "Canonical event envelope contract (Sprint 1 baseline). PUBLISHED as the repository event authority per machine-contract-bootstrap (IMPL-CONTRACT-001). No business event schemas are published yet.",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "event_version",
    "occurred_at",
    "producer",
    "data"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "type": "string",
      "minLength": 1
    },
    "event_version": {
      "type": "integer",
      "minimum": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "string",
      "minLength": 1
    },
    "aggregate_id": {
      "type": ["string", "null"]
    },
    "correlation_id": {
      "type": ["string", "null"]
    },
    "causation_id": {
      "type": ["string", "null"]
    },
    "traceparent": {
      "type": ["string", "null"]
    },
    "data_classification": {
      "type": "string",
      "enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "RESTRICTED", "HIGHLY_RESTRICTED"]
    },
    "data": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
