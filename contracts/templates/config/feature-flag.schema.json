{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Feature Flag Definition Template",
  "type": "object",
  "required": [
    "code",
    "enabled",
    "scope",
    "version"
  ],
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]+$"
    },
    "enabled": {
      "type": "boolean"
    },
    "scope": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "starts_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "ends_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
