{
  "name": "crm-bds-ai-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "CRM_BDS_AI frontend shell (Sprint 1 Engineering Foundation). No business UI.",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": "24.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "generate:api": "openapi-typescript ../contracts/openapi/openapi.json -o generated/api.d.ts",
    "check:api-drift": "openapi-typescript ../contracts/openapi/openapi.json -o /tmp/api.drift.d.ts && diff -q /tmp/api.drift.d.ts generated/api.d.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.80.0",
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.30.0",
    "eslint-config-next": "16.2.11",
    "jsdom": "^26.0.0",
    "openapi-typescript": "^7.6.0",
    "tailwindcss": "^4.1.0",
    "typescript": "6.0.3",
    "vitest": "^3.2.0"
  }
}
